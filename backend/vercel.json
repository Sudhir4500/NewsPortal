{
  "version": 2,
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.11" }
    },
    {
      "src": "core/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.11" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "core/wsgi.py",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "core.settings",
    "DJANGO_SECRET_KEY": "your-secret-key",
    "DEBUG": "False"
  }
}