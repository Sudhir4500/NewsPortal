{
    "version": 2,
    "builds": [
        {
        "src": "build_files.sh",
        "use": "@vercel/python",
        "config": { "pythonVersion": "3.9" }
      },
        {
            "src": "core/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "pythonVersion": "3.9"
            }
        },
        {
            "src": "staticfiles/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/staticfiles/$1"
        },
        {
            "src": "/(.*)",
            "dest": "core/wsgi.py"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "core.settings"
    }
}